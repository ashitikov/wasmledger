package wasmledger:extension@0.1.0;

interface id-gen {
  use wasm-sql:core/query@0.1.0.{query-executor};

  generate-ids: async func(executor: query-executor, count: u32) -> result<list<s64>, string>;
}

interface lifecycle {
  on-init: async func();

  on-shutdown: async func();
}

interface migration {
  record migration {
    id: string,
    sql: string,
  }

  extension-id: func() -> string;

  get-migrations: func() -> list<migration>;
}

